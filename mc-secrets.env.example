# MatrixClaw-Nano lab secrets -- your three passwords, chosen by you.
#
# HOW TO USE:
#   1. Copy this file to  mc-secrets.env  (same folder).
#   2. Fill in a value after each = below. Choose your own passwords.
#   3. Run:  bin/mc-place-secrets
#   4. Delete mc-secrets.env when it reports success.
#
# You do NOT set the Ceph storage key here -- the tool reads it for you from the
# storage cluster you built in package 05.
#
# These three passwords are yours to choose. They are placed on the lab machines and
# are never sent anywhere. Avoid a leading or trailing space in a value.

# The root password for MySQL on the management server.
mysql_root_password=

# The password CloudStack's own database user will use.
cloudstack_db_password=

# The root password for the KVM compute hosts. CloudStack uses this to add each
# compute host, so the tool puts the SAME value on the management server and on both
# compute hosts for you -- one password, placed in the three right places.
host_root_password=
