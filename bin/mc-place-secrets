#!/usr/bin/env python3
"""Place the lab's five secrets, from one filled-in template, in one command.

This is a companion to `mcnano`, and it is NOT the runner. It writes no run record and
it is not gated by an approval digest, because it does one thing only: put the reader's
secret values into a root-only file on each host that needs them. Nano's engine never
sees a secret and this helper does not change that -- the value transits it exactly as
much as it transits the reader's own shell when they type it, and no further. See
nano/secrets.py for why that boundary is drawn where it is.

What it does:
  * reads three passwords you chose from a template file (default: ./mc-secrets.env);
  * fetches the Ceph storage key for you, so you do not copy a 40-character string;
  * writes /root/.mc-secrets.env (mode 600) on mgmt-01, kvm-01 and kvm-02, each with
    exactly the variables that host's packages need;
  * shows you what it will do -- the hosts and the variable NAMES, never the values --
    and asks before it does anything;
  * verifies each file afterwards, printing only OK markers.

It reaches the hosts the same way Nano does: over SSH, key auth, BatchMode, using the
host map in hosts/laptop32.json. It reads that map directly rather than importing any
of Nano's engine, so the separation is physical.

    bin/mc-place-secrets [--template PATH] [--hosts PATH] [--dest PATH] [--yes]
"""

import argparse
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
sys.path.insert(0, ROOT)

from nano import secrets   # noqa: E402  (pure composition; no runner, no record)

DEFAULT_DEST = "/root/.mc-secrets.env"
CEPH_HOST = "ceph-01"
GET_KEY = "sudo cephadm shell -- ceph auth get-key client.cloudstack"


def _expand(path):
    return os.path.expanduser(os.path.expandvars(path))


def load_hosts(path):
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)
    d = data.get("defaults", {})
    return data.get("hosts", {}), d


def ssh_argv(defaults, address, command):
    """The exact ssh invocation, matching Nano's transport conventions."""
    argv = ["ssh", "-o", "BatchMode=yes"]
    skc = defaults.get("strict_host_key_checking")
    if skc:
        argv += ["-o", "StrictHostKeyChecking=%s" % skc]
    kh = defaults.get("known_hosts")
    if kh:
        argv += ["-o", "UserKnownHostsFile=%s" % _expand(kh)]
    ct = defaults.get("connect_timeout")
    if ct:
        argv += ["-o", "ConnectTimeout=%s" % ct]
    idf = defaults.get("identity_file")
    if idf:
        argv += ["-o", "IdentitiesOnly=yes", "-i", _expand(idf)]
    user = defaults.get("user", "labadmin")
    argv.append("%s@%s" % (user, address))
    argv.append(command)
    return argv


def run_ssh(defaults, address, command, stdin=None, timeout=60):
    proc = subprocess.run(
        ssh_argv(defaults, address, command),
        input=stdin, capture_output=True, text=True, timeout=timeout)
    return proc.returncode, proc.stdout, proc.stderr


def fetch_rbd_secret(hosts, defaults):
    node = hosts.get(CEPH_HOST)
    if not node:
        raise SystemExit("  host map has no %s; cannot fetch the Ceph key." % CEPH_HOST)
    rc, out, err = run_ssh(defaults, node["address"], GET_KEY, timeout=120)
    key = out.strip()
    if rc != 0 or not key:
        raise SystemExit(
            "  could not read the Ceph key from %s (rc=%d). Is the storage cluster "
            "(package 05) built?\n  %s" % (CEPH_HOST, rc, (err or "").strip()[:200]))
    # The key is the one secret this tool touches on stdout, from the far host. It is
    # NOT printed: it goes straight into compose() and out over the next SSH pipe.
    return key


def place(hosts, defaults, name, address, contents, dest):
    rc, _o, err = run_ssh(defaults, address,
                          "sudo tee %s >/dev/null && sudo chmod 600 %s" % (dest, dest),
                          stdin=contents)
    if rc != 0:
        raise SystemExit("  FAILED to place on %s (rc=%d): %s"
                         % (name, rc, (err or "").strip()[:200]))


def verify(defaults, name, address, dest, need):
    """Confirm the file exists, is 600, and yields the expected non-empty vars.

    Prints an OK marker and nothing of the contents. `need` is the list of variable
    names that must be present and non-empty on this host.
    """
    tests = " && ".join('test -n "$%s"' % v for v in need)
    cmd = ("sudo bash -c '. %s && %s' && "
           "test \"$(sudo stat -c %%a %s)\" = 600 && echo SECRETS-OK"
           % (dest, tests, dest))
    rc, out, _e = run_ssh(defaults, address, cmd)
    ok = rc == 0 and "SECRETS-OK" in out
    print("    %-8s %s" % (name, "SECRETS-OK" if ok else "NOT VERIFIED"))
    return ok


def main():
    ap = argparse.ArgumentParser(description="Place the lab secrets from one template.")
    ap.add_argument("--template", default=os.path.join(os.getcwd(), "mc-secrets.env"))
    ap.add_argument("--hosts", default=os.path.join(ROOT, "hosts", "laptop32.json"))
    ap.add_argument("--dest", default=DEFAULT_DEST)
    ap.add_argument("--yes", action="store_true", help="do not ask before placing")
    args = ap.parse_args()

    if not os.path.isfile(args.template):
        raise SystemExit(
            "  no template at %s.\n"
            "  Copy mc-secrets.env.example to mc-secrets.env, fill in the three\n"
            "  passwords, and run this again." % args.template)

    with open(args.template, encoding="utf-8") as fh:
        values = secrets.parse_template(fh.read())
    hosts, defaults = load_hosts(args.hosts)

    print("\n  Placing lab secrets. Nothing here is shown or stored; values go straight")
    print("  into a root-only file on each host.\n")
    print("  Fetching the Ceph storage key from %s ..." % CEPH_HOST)
    rbd = fetch_rbd_secret(hosts, defaults)
    print("  got it.\n")

    files = secrets.compose(values, rbd)
    need = {"mgmt-01": ["MC_MYSQL_ROOT_PASS", "MC_DB_PASS",
                        "MC_HOST_ROOTPASS", "MC_RBD_SECRET"],
            "kvm-01": ["MC_KVM_ROOT_PASS"],
            "kvm-02": ["MC_KVM_ROOT_PASS"]}

    print("  Will write %s (mode 600) on:" % args.dest)
    for name in ("mgmt-01", "kvm-01", "kvm-02"):
        print("    %-8s (%s)  <- %s"
              % (name, hosts[name]["address"], ", ".join(need[name])))
    print("")

    if not args.yes:
        try:
            answer = input("  Place these now? [y/N] ")
        except (EOFError, KeyboardInterrupt):
            raise SystemExit("\n  cancelled; nothing placed.")
        if answer.strip().lower() not in ("y", "yes"):
            raise SystemExit("  declined; nothing placed.")

    for name in ("mgmt-01", "kvm-01", "kvm-02"):
        place(hosts, defaults, name, hosts[name]["address"], files[name], args.dest)
    print("\n  Placed. Verifying (markers only):")
    ok = all(verify(defaults, n, hosts[n]["address"], args.dest, need[n])
             for n in ("mgmt-01", "kvm-01", "kvm-02"))

    print("")
    if not ok:
        raise SystemExit("  One or more files did not verify. Do NOT run package 07 yet.")
    print("  All three verified. You can run package 07.")
    print("  Now delete your template so the passwords do not linger on disk:")
    print("    shred -u %s   # or: rm -P %s\n" % (args.template, args.template))
    return 0


if __name__ == "__main__":
    sys.exit(main())
